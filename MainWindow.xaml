<Window x:Class="SimpleBank.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleBank"
        mc:Ignorable="d"
        Title="Главное меню приложения" 
        Height="750" 
        Width="900"
        MinHeight="700"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/icon.ico"
        Closing="Window_Closing">
    <Grid Background="{StaticResource WhiteBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Заголовок с кнопкой выхода -->
        <Border Grid.Row="0" 
                Background="{StaticResource MatteBlueBrush}" 
                Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0"
                           Text="Главное меню приложения"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource WhiteBrush}"
                           VerticalAlignment="Center"/>
                
                <Button Grid.Column="1"
                        Name="btnExit"
                        Content="Выход"
                        Style="{StaticResource ExitButtonStyle}"
                        Click="btnExit_Click"
                        Width="100"/>
            </Grid>
        </Border>
        
        <!-- Область с логотипом -->
        <Border Grid.Row="1" 
                Background="{StaticResource MatteLightBlueBrush}" 
                Padding="20,30">
            <StackPanel HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Resources/logo.png" 
                       Width="200" 
                       Height="100"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>
                <TextBlock Text="Добро пожаловать в банк!"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource MatteDarkBlueBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Основное меню с кнопками -->
        <Grid Grid.Row="2" 
              Margin="40,20"
              VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                <Button Name="btnClient"
                        Content="Клиент банка"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="btnClient_Click"
                        Height="65"/>
                
                <Button Name="btnEmployee"
                        Content="Сотрудник банка"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="btnEmployee_Click"
                        Height="65"/>
                
                <Button Name="btnAdministrator"
                        Content="Системный администратор"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="btnAdministrator_Click"
                        Height="65"/>
            </StackPanel>
        </Grid>
        
        <!-- Подвал -->
        <Border Grid.Row="3" 
                Background="{StaticResource MatteLightBlueBrush}" 
                Padding="20,15">
            <Grid>
                <TextBlock Text="Банковское приложение SPBKIT Bank"
                           FontSize="14"
                           Foreground="{StaticResource MatteDarkBlueBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                
                <!-- Скрытая кнопка тестирования - маленькая прозрачная точка в правом нижнем углу -->
                <Button Name="btnTest"
                        Click="btnTest_Click"
                        Width="8"
                        Height="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,5,5"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Тестирование классов"
                        Opacity="0.1">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent"
                                    CornerRadius="4"
                                    Width="8"
                                    Height="8">
                                <Border Background="{StaticResource MatteDarkBlueBrush}"
                                        CornerRadius="4"
                                        Width="8"
                                        Height="8"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
