<Window x:Class="SimpleBank.View.CreateEmployeeAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Создание нового аккаунта сотрудника" 
        Height="550" 
        Width="600"
        MinHeight="500"
        MinWidth="550"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/icon.ico"
        Closing="Window_Closing">
    <Grid Background="{StaticResource WhiteBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Заголовок -->
        <Border Grid.Row="0" 
                Background="{StaticResource MatteBlueBrush}" 
                Padding="20,15">
            <TextBlock Text="Создание нового аккаунта сотрудника"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource WhiteBrush}"
                       VerticalAlignment="Center"/>
        </Border>
        
        <!-- Основная область с полями ввода -->
        <Grid Grid.Row="1" 
              Margin="50,30"
              VerticalAlignment="Center">
            <StackPanel>
                <!-- Поле логина -->
                <TextBlock Text="Логин:"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MatteDarkBlueBrush}"
                           Margin="0,0,0,8"/>
                <TextBox Name="txtLogin"
                         Style="{StaticResource InputTextBoxStyle}"
                         Height="42"
                         Margin="0,0,0,15"/>
                
                <!-- Поле пароля -->
                <TextBlock Text="Пароль:"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MatteDarkBlueBrush}"
                           Margin="0,0,0,8"/>
                <PasswordBox Name="txtPassword"
                             Style="{StaticResource InputPasswordBoxStyle}"
                             Height="42"
                             Margin="0,0,0,15"/>
                
                <!-- Поле подтверждения пароля -->
                <TextBlock Text="Подтвердите пароль:"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MatteDarkBlueBrush}"
                           Margin="0,0,0,8"/>
                <PasswordBox Name="txtPasswordConfirm"
                             Style="{StaticResource InputPasswordBoxStyle}"
                             Height="42"
                             Margin="0,0,0,15"/>
                
                <!-- Поле ФИО -->
                <TextBlock Text="ФИО сотрудника:"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MatteDarkBlueBrush}"
                           Margin="0,0,0,8"/>
                <TextBox Name="txtFullName"
                         Style="{StaticResource InputTextBoxStyle}"
                         Height="42"
                         Margin="0,0,0,20"/>
                
                <!-- Кнопка "Создать" -->
                <Button Name="btnCreate"
                        Content="Создать аккаунт"
                        Style="{StaticResource LoginButtonStyle}"
                        Click="btnCreate_Click"
                        HorizontalAlignment="Stretch"
                        Height="45"
                        Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
        
        <!-- Подвал -->
        <Border Grid.Row="2" 
                Background="{StaticResource MatteLightBlueBrush}" 
                Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0"
                           Text="Банковское приложение SPBKIT Bank"
                           FontSize="12"
                           Foreground="{StaticResource MatteDarkBlueBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                
                <Button Grid.Column="1"
                        Name="btnCancel"
                        Content="Отмена"
                        Style="{StaticResource BackButtonStyle}"
                        Click="btnCancel_Click"
                        Width="100"/>
            </Grid>
        </Border>
    </Grid>
</Window>

