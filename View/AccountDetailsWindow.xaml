<Window x:Class="SimpleBank.View.AccountDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Детальная информация о счете" 
        Height="600" 
        Width="700"
        MinHeight="550"
        MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/icon.ico"
        Closing="Window_Closing">
    <Grid Background="{StaticResource WhiteBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Заголовок с кнопкой "Назад" -->
        <Border Grid.Row="0" 
                Background="{StaticResource MatteBlueBrush}" 
                Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0"
                           Text="Детальная информация о счете"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource WhiteBrush}"
                           VerticalAlignment="Center"/>
                
                <Button Grid.Column="1"
                        Name="btnBack"
                        Content="Назад"
                        Style="{StaticResource BackButtonStyle}"
                        Click="btnBack_Click"
                        Width="100"/>
            </Grid>
        </Border>
        
        <!-- Область с логотипом -->
        <Border Grid.Row="1" 
                Background="{StaticResource MatteLightBlueBrush}" 
                Padding="20,20">
            <StackPanel HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Resources/logo.png" 
                       Width="140" 
                       Height="70"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Основная область с информацией о счете -->
        <Grid Grid.Row="2" 
              Margin="40,30"
              VerticalAlignment="Top">
            <StackPanel>
                <!-- Номер счета -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Номер счета:"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MatteDarkBlueBrush}"/>
                    <TextBlock Grid.Column="1"
                               Name="txtAccountNumber"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#333333"/>
                </Grid>
                
                <!-- Владелец (ФИО) -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Владелец:"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MatteDarkBlueBrush}"/>
                    <TextBlock Grid.Column="1"
                               Name="txtOwner"
                               FontSize="14"
                               Foreground="#333333"
                               TextWrapping="Wrap"/>
                </Grid>
                
                <!-- Дата открытия -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Дата открытия:"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MatteDarkBlueBrush}"/>
                    <TextBlock Grid.Column="1"
                               Name="txtOpeningDate"
                               FontSize="14"
                               Foreground="#333333"/>
                </Grid>
                
                <!-- Баланс (крупным шрифтом) -->
                <Border Margin="0,0,0,20"
                        Background="#F0F8FF"
                        BorderBrush="{StaticResource MatteBlueBrush}"
                        BorderThickness="2"
                        Padding="20,15"
                        CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Баланс:"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MatteDarkBlueBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Name="txtBalance"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#0066CC"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                
                <!-- Статус счета (с цветовой индикацией) -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Статус счета:"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MatteDarkBlueBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Name="statusIndicator"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Name="txtStatus"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                
                <!-- Срок вклада (дни) -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Срок вклада:"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MatteDarkBlueBrush}"/>
                    <TextBlock Grid.Column="1"
                               Name="txtDepositTermDays"
                               FontSize="14"
                               Foreground="#333333"/>
                </Grid>
                
                <!-- Дата окончания вклада -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Дата окончания вклада:"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MatteDarkBlueBrush}"/>
                    <TextBlock Grid.Column="1"
                               Name="txtDepositEndDate"
                               FontSize="14"
                               Foreground="#333333"/>
                </Grid>
                
                <!-- Расчетная дата закрытия (если применимо) -->
                <Grid Margin="0,0,0,0"
                      Name="gridClosingDate"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Дата закрытия:"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MatteDarkBlueBrush}"/>
                    <TextBlock Grid.Column="1"
                               Name="txtClosingDate"
                               FontSize="14"
                               Foreground="#333333"/>
                </Grid>
            </StackPanel>
        </Grid>
        
        <!-- Подвал -->
        <Border Grid.Row="3" 
                Background="{StaticResource MatteLightBlueBrush}" 
                Padding="20,15">
            <TextBlock Text="Банковское приложение SPBKIT Bank"
                       FontSize="12"
                       Foreground="{StaticResource MatteDarkBlueBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>

