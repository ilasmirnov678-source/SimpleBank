<Window x:Class="SimpleBank.View.BankAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Работа с банковскими счетами" 
        Height="700" 
        Width="1000"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/icon.ico"
        Closing="Window_Closing">
    <Grid Background="{StaticResource WhiteBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Заголовок с кнопкой "Назад" -->
        <Border Grid.Row="0" 
                Background="{StaticResource MatteBlueBrush}" 
                Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0"
                           Text="Работа с банковскими счетами"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource WhiteBrush}"
                           VerticalAlignment="Center"/>
                
                <Button Grid.Column="1"
                        Name="btnBack"
                        Content="Назад"
                        Style="{StaticResource BackButtonStyle}"
                        Click="btnBack_Click"
                        Width="100"/>
            </Grid>
        </Border>
        
        <!-- Область с логотипом -->
        <Border Grid.Row="1" 
                Background="{StaticResource MatteLightBlueBrush}" 
                Padding="20,20">
            <StackPanel HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Resources/logo.png" 
                       Width="160" 
                       Height="80"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
                <TextBlock Text="Управление банковскими счетами"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource MatteDarkBlueBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Основная область с секциями для двух счетов -->
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="20,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Секция для первого счета -->
                <Border Grid.Row="0" Grid.Column="0"
                        BorderBrush="{StaticResource MatteBlueBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="20"
                        Background="{StaticResource MatteLightBlueBrush}">
                    <StackPanel>
                        <TextBlock Text="Счет 1"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MatteDarkBlueBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>
                        
                        <!-- Группа "Информация о счете" -->
                        <GroupBox Header="Информация о счете"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource MatteDarkBlueBrush}"
                                  Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <TextBlock Text="Номер счета:" 
                                           FontSize="12"
                                           Margin="0,5,0,5"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Name="txtAccount1Number"
                                             Style="{StaticResource AccountInputTextBoxStyle}"
                                             Height="42"
                                             MaxLength="20"
                                             PreviewTextInput="txtAccount1Number_PreviewTextInput"
                                             PreviewKeyDown="txtAccount1Number_PreviewKeyDown"
                                             TextChanged="txtAccount1Number_TextChanged"
                                             LostFocus="txtAccount1Number_LostFocus"
                                             Margin="0,0,5,0"/>
                                    <Button Grid.Column="1"
                                            Name="btnGenerateAccount1Number"
                                            Width="42"
                                            Height="42"
                                            Style="{StaticResource GenerateButtonStyle}"
                                            Click="btnGenerateAccount1Number_Click"
                                            ToolTip="Сгенерировать случайный номер счета"
                                            Padding="0">
                                        <Image Source="pack://application:,,,/Resources/dice.png"
                                               Width="42"
                                               Height="42"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Button>
                                </Grid>
                                
                                <TextBlock Text="Дата открытия:" 
                                           FontSize="12"
                                           Margin="0,5,0,5"/>
                                <DatePicker Name="dpAccount1OpeningDate"
                                            Style="{StaticResource AccountDatePickerStyle}"
                                            Height="42"
                                            Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Владелец:" 
                                           FontSize="12"
                                           Margin="0,5,0,5"/>
                                <ComboBox Name="cmbAccount1Owner"
                                          Style="{StaticResource AccountComboBoxStyle}"
                                          Height="42"
                                          Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Начальный баланс (₽):" 
                                           FontSize="12"
                                           Margin="0,5,0,5"/>
                                <TextBox Name="txtAccount1Balance"
                                         Style="{StaticResource AccountInputTextBoxStyle}"
                                         Height="42"
                                         PreviewTextInput="txtAccount1Balance_PreviewTextInput"
                                         PreviewKeyDown="txtAccount1Balance_PreviewKeyDown"
                                         Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Срок вклада (дни):" 
                                           FontSize="12"
                                           Margin="0,5,0,5"/>
                                <TextBox Name="txtAccount1DepositTerm"
                                         Style="{StaticResource AccountInputTextBoxStyle}"
                                         Height="42"
                                         Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Статус:" 
                                           FontSize="12"
                                           Margin="0,5,0,5"/>
                                <ComboBox Name="cmbAccount1Status"
                                          Style="{StaticResource AccountComboBoxStyle}"
                                          Height="42"
                                          Margin="0,0,0,10"/>
                                
                                <Button Name="btnAccount1Create"
                                        Content="Создать/Обновить счет"
                                        Style="{StaticResource MenuButtonStyle}"
                                        FontSize="14"
                                        Padding="15,10"
                                        Height="40"
                                        Click="btnAccount1Create_Click"
                                        Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Группа "Операции" -->
                        <GroupBox Header="Операции"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource MatteDarkBlueBrush}"
                                  Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <TextBlock Text="Сумма операции (₽):" 
                                           FontSize="12"
                                           Margin="0,5,0,5"/>
                                <TextBox Name="txtAccount1Amount"
                                         Style="{StaticResource AccountInputTextBoxStyle}"
                                         Height="42"
                                         PreviewTextInput="txtAccount1Amount_PreviewTextInput"
                                         PreviewKeyDown="txtAccount1Amount_PreviewKeyDown"
                                         Margin="0,0,0,10"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Button Grid.Row="0" Grid.Column="0"
                                            Name="btnAccount1Deposit"
                                            Content="Пополнить"
                                            Style="{StaticResource MenuButtonStyle}"
                                            FontSize="12"
                                            Padding="10,8"
                                            Height="35"
                                            Click="btnAccount1Deposit_Click"/>
                                    
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Name="btnAccount1Withdraw"
                                            Content="Снять"
                                            Style="{StaticResource MenuButtonStyle}"
                                            FontSize="12"
                                            Padding="10,8"
                                            Height="35"
                                            Click="btnAccount1Withdraw_Click"/>
                                    
                                    <Button Grid.Row="2" Grid.Column="0"
                                            Name="btnAccount1Zero"
                                            Content="Обнулить"
                                            Style="{StaticResource MenuButtonStyle}"
                                            FontSize="12"
                                            Padding="10,8"
                                            Height="35"
                                            Click="btnAccount1Zero_Click"/>
                                    
                                    <Button Grid.Row="2" Grid.Column="2"
                                            Name="btnAccount1Bankrupt"
                                            Content="Проверить банкрот"
                                            Style="{StaticResource MenuButtonStyle}"
                                            FontSize="12"
                                            Padding="10,8"
                                            Height="35"
                                            Click="btnAccount1Bankrupt_Click"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Группа "Текущее состояние" -->
                        <GroupBox Header="Текущее состояние"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource MatteDarkBlueBrush}"
                                  Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <TextBlock>
                                    <Run Text="Номер счета: " FontWeight="SemiBold"/>
                                    <Run Name="lblAccount1Number" Text="—"/>
                                </TextBlock>
                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Баланс: " FontWeight="SemiBold"/>
                                    <Run Name="lblAccount1Balance" Text="—"/>
                                </TextBlock>
                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Статус: " FontWeight="SemiBold"/>
                                    <Run Name="lblAccount1Status" Text="—"/>
                                </TextBlock>
                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Дата открытия: " FontWeight="SemiBold"/>
                                    <Run Name="lblAccount1OpeningDate" Text="—"/>
                                </TextBlock>
                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Дата закрытия: " FontWeight="SemiBold"/>
                                    <Run Name="lblAccount1ClosingDate" Text="—"/>
                                </TextBlock>
                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Дней до закрытия: " FontWeight="SemiBold"/>
                                    <Run Name="lblAccount1DaysLeft" Text="—"/>
                                </TextBlock>
                                
                                <Button Name="btnAccount1Refresh"
                                        Content="Обновить информацию"
                                        Style="{StaticResource MenuButtonStyle}"
                                        FontSize="12"
                                        Padding="15,8"
                                        Height="35"
                                        Click="btnAccount1Refresh_Click"
                                        Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Border>
                
                <!-- Разделитель -->
                <Border Grid.Row="0" Grid.Column="1" 
                        Background="{StaticResource MatteBlueBrush}"
                        Width="2"/>
                
                <!-- Секция для второго счета -->
                <Border Grid.Row="0" Grid.Column="2"
                        BorderBrush="{StaticResource MatteBlueBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="20"
                        Background="{StaticResource MatteLightBlueBrush}">
                    <StackPanel>
                        <TextBlock Text="Счет 2"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MatteDarkBlueBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>
                        
                        <!-- Группа "Информация о счете" -->
                        <GroupBox Header="Информация о счете"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource MatteDarkBlueBrush}"
                                  Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <TextBlock Text="Номер счета:" 
                                           FontSize="12"
                                           Margin="0,5,0,5"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Name="txtAccount2Number"
                                             Style="{StaticResource AccountInputTextBoxStyle}"
                                             Height="42"
                                             MaxLength="20"
                                             PreviewTextInput="txtAccount2Number_PreviewTextInput"
                                             PreviewKeyDown="txtAccount2Number_PreviewKeyDown"
                                             TextChanged="txtAccount2Number_TextChanged"
                                             LostFocus="txtAccount2Number_LostFocus"
                                             Margin="0,0,5,0"/>
                                    <Button Grid.Column="1"
                                            Name="btnGenerateAccount2Number"
                                            Width="42"
                                            Height="42"
                                            Style="{StaticResource GenerateButtonStyle}"
                                            Click="btnGenerateAccount2Number_Click"
                                            ToolTip="Сгенерировать случайный номер счета"
                                            Padding="0">
                                        <Image Source="pack://application:,,,/Resources/dice.png"
                                               Width="42"
                                               Height="42"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Button>
                                </Grid>
                                
                                <TextBlock Text="Дата открытия:" 
                                           FontSize="12"
                                           Margin="0,5,0,5"/>
                                <DatePicker Name="dpAccount2OpeningDate"
                                            Style="{StaticResource AccountDatePickerStyle}"
                                            Height="42"
                                            Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Владелец:" 
                                           FontSize="12"
                                           Margin="0,5,0,5"/>
                                <ComboBox Name="cmbAccount2Owner"
                                          Style="{StaticResource AccountComboBoxStyle}"
                                          Height="42"
                                          Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Начальный баланс (₽):" 
                                           FontSize="12"
                                           Margin="0,5,0,5"/>
                                <TextBox Name="txtAccount2Balance"
                                         Style="{StaticResource AccountInputTextBoxStyle}"
                                         Height="42"
                                         PreviewTextInput="txtAccount2Balance_PreviewTextInput"
                                         PreviewKeyDown="txtAccount2Balance_PreviewKeyDown"
                                         Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Срок вклада (дни):" 
                                           FontSize="12"
                                           Margin="0,5,0,5"/>
                                <TextBox Name="txtAccount2DepositTerm"
                                         Style="{StaticResource AccountInputTextBoxStyle}"
                                         Height="42"
                                         Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Статус:" 
                                           FontSize="12"
                                           Margin="0,5,0,5"/>
                                <ComboBox Name="cmbAccount2Status"
                                          Style="{StaticResource AccountComboBoxStyle}"
                                          Height="42"
                                          Margin="0,0,0,10"/>
                                
                                <Button Name="btnAccount2Create"
                                        Content="Создать/Обновить счет"
                                        Style="{StaticResource MenuButtonStyle}"
                                        FontSize="14"
                                        Padding="15,10"
                                        Height="40"
                                        Click="btnAccount2Create_Click"
                                        Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Группа "Операции" -->
                        <GroupBox Header="Операции"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource MatteDarkBlueBrush}"
                                  Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <TextBlock Text="Сумма операции (₽):" 
                                           FontSize="12"
                                           Margin="0,5,0,5"/>
                                <TextBox Name="txtAccount2Amount"
                                         Style="{StaticResource AccountInputTextBoxStyle}"
                                         Height="42"
                                         PreviewTextInput="txtAccount2Amount_PreviewTextInput"
                                         PreviewKeyDown="txtAccount2Amount_PreviewKeyDown"
                                         Margin="0,0,0,10"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Button Grid.Row="0" Grid.Column="0"
                                            Name="btnAccount2Deposit"
                                            Content="Пополнить"
                                            Style="{StaticResource MenuButtonStyle}"
                                            FontSize="12"
                                            Padding="10,8"
                                            Height="35"
                                            Click="btnAccount2Deposit_Click"/>
                                    
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Name="btnAccount2Withdraw"
                                            Content="Снять"
                                            Style="{StaticResource MenuButtonStyle}"
                                            FontSize="12"
                                            Padding="10,8"
                                            Height="35"
                                            Click="btnAccount2Withdraw_Click"/>
                                    
                                    <Button Grid.Row="2" Grid.Column="0"
                                            Name="btnAccount2Zero"
                                            Content="Обнулить"
                                            Style="{StaticResource MenuButtonStyle}"
                                            FontSize="12"
                                            Padding="10,8"
                                            Height="35"
                                            Click="btnAccount2Zero_Click"/>
                                    
                                    <Button Grid.Row="2" Grid.Column="2"
                                            Name="btnAccount2Bankrupt"
                                            Content="Проверить банкрот"
                                            Style="{StaticResource MenuButtonStyle}"
                                            FontSize="12"
                                            Padding="10,8"
                                            Height="35"
                                            Click="btnAccount2Bankrupt_Click"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Группа "Текущее состояние" -->
                        <GroupBox Header="Текущее состояние"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource MatteDarkBlueBrush}"
                                  Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <TextBlock>
                                    <Run Text="Номер счета: " FontWeight="SemiBold"/>
                                    <Run Name="lblAccount2Number" Text="—"/>
                                </TextBlock>
                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Баланс: " FontWeight="SemiBold"/>
                                    <Run Name="lblAccount2Balance" Text="—"/>
                                </TextBlock>
                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Статус: " FontWeight="SemiBold"/>
                                    <Run Name="lblAccount2Status" Text="—"/>
                                </TextBlock>
                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Дата открытия: " FontWeight="SemiBold"/>
                                    <Run Name="lblAccount2OpeningDate" Text="—"/>
                                </TextBlock>
                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Дата закрытия: " FontWeight="SemiBold"/>
                                    <Run Name="lblAccount2ClosingDate" Text="—"/>
                                </TextBlock>
                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Дней до закрытия: " FontWeight="SemiBold"/>
                                    <Run Name="lblAccount2DaysLeft" Text="—"/>
                                </TextBlock>
                                
                                <Button Name="btnAccount2Refresh"
                                        Content="Обновить информацию"
                                        Style="{StaticResource MenuButtonStyle}"
                                        FontSize="12"
                                        Padding="15,8"
                                        Height="35"
                                        Click="btnAccount2Refresh_Click"
                                        Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Border>
                
                <!-- Секция перевода средств между счетами -->
                <Border Grid.Row="1" 
                        Grid.Column="0" 
                        Grid.ColumnSpan="3"
                        BorderBrush="{StaticResource MatteDarkBlueBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="20"
                        Background="{StaticResource WhiteBrush}"
                        Margin="0,20,0,0">
                    <GroupBox Header="Перевод средств между счетами"
                              FontSize="16"
                              FontWeight="Bold"
                              Foreground="{StaticResource MatteDarkBlueBrush}"
                              Margin="0">
                        <StackPanel Margin="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Счет отправитель:"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="0" Grid.Column="2"
                                          Name="cmbTransferFrom"
                                          FontSize="12"
                                          Padding="8,5"
                                          Height="35"
                                          Margin="0,0,0,0">
                                    <ComboBoxItem Content="Счет 1" Tag="Account1"/>
                                    <ComboBoxItem Content="Счет 2" Tag="Account2"/>
                                </ComboBox>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Счет получатель:"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="2" Grid.Column="2"
                                          Name="cmbTransferTo"
                                          FontSize="12"
                                          Padding="8,5"
                                          Height="35"
                                          Margin="0,0,0,0">
                                    <ComboBoxItem Content="Счет 1" Tag="Account1"/>
                                    <ComboBoxItem Content="Счет 2" Tag="Account2"/>
                                </ComboBox>
                                
                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Text="Сумма перевода (₽):"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Row="4" Grid.Column="2"
                                         Name="txtTransferAmount"
                                         Style="{StaticResource AccountInputTextBoxStyle}"
                                         Height="42"
                                         PreviewTextInput="txtTransferAmount_PreviewTextInput"
                                         PreviewKeyDown="txtTransferAmount_PreviewKeyDown"
                                         Margin="0,0,0,0"/>
                                
                                <Button Grid.Row="4" Grid.Column="4"
                                        Name="btnTransfer"
                                        Content="Выполнить перевод"
                                        Style="{StaticResource MenuButtonStyle}"
                                        FontSize="14"
                                        Padding="20,10"
                                        Height="40"
                                        Click="btnTransfer_Click"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>
                            
                            <TextBlock Name="lblTransferResult"
                                       FontSize="12"
                                       Foreground="{StaticResource MatteDarkBlueBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,15,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </GroupBox>
                </Border>
            </Grid>
        </ScrollViewer>
        
        <!-- Подвал -->
        <Border Grid.Row="3" 
                Background="{StaticResource MatteLightBlueBrush}" 
                Padding="20,15">
            <TextBlock Text="Банковское приложение SPBKIT Bank"
                       FontSize="12"
                       Foreground="{StaticResource MatteDarkBlueBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>

